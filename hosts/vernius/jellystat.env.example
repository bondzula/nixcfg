# Copy to /mnt/appdata/jellystat/secrets.env on vernius (root:root, chmod 600).
# Migrating from selfhosted/jellyfin/.env: same values, JELLYSTAT_ prefix dropped
# (the file is now passed to the containers directly, no compose interpolation).
#
# JELLYSTAT_POSTGRES_DB       -> POSTGRES_DB
# JELLYSTAT_POSTGRES_USER     -> POSTGRES_USER
# JELLYSTAT_POSTGRES_PASSWORD -> POSTGRES_PASSWORD
# JELLYSTAT_JWT_SECRET        -> JWT_SECRET

POSTGRES_DB=jfstat
POSTGRES_USER=jellyfin_user
POSTGRES_PASSWORD=change_this_to_secure_password
JWT_SECRET=change_this_to_secure_jwt_secret
