# macOS applications and command-line tools for the oslo host.
#
# Install everything with:
#   brew bundle --file ./Brewfile
#
# Preview packages that are no longer declared here with:
#   brew bundle cleanup --file ./Brewfile
#
# Deliberately do not add --force to cleanup until its output has been reviewed.

